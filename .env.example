# Copy to .env and fill in the values you need.
# With no API key the system runs fully offline in "mock" mode.

# mock | openai. If unset, it becomes "openai" automatically when a key exists.
LLM_PROVIDER=mock

# Any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Qwen, local vLLM, Ollama gateway...).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# Deterministic A/B bucketing; split is the share of traffic in variant A.
AB_ENABLED=true
AB_SPLIT=0.5

# Pause at the compliance node for human approval (CLI auto-approves for the demo).
REQUIRE_APPROVAL=false
MAX_AGENT_RETRIES=1

# Data files (SQLite is created and seeded on first run).
# ECOM_DB_PATH=data/ecom.db
# ECOM_SEED_PATH=data/seed.json

LOG_LEVEL=INFO
TRACE_STORE_SIZE=200
